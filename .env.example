# ============================================
# BI Agent - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to source control.

# --- Application ---
APP_NAME=bi-agent
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
ENCRYPTION_KEY=change-me-to-a-fernet-key

# --- Database (Application Metadata) ---
DATABASE_URL=postgresql+asyncpg://biagent:biagent_password@localhost:5432/biagent
DATABASE_URL_SYNC=postgresql://biagent:biagent_password@localhost:5432/biagent

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- AI / LLM ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-api-key-here
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- JWT ---
JWT_SECRET_KEY=change-me-to-another-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File Uploads ---
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Query Safety ---
QUERY_TIMEOUT_SECONDS=30
QUERY_MAX_ROWS=10000
QUERY_MAX_RESULT_SIZE_MB=10

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
