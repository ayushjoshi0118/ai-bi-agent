# ==============================================================================
# BI Agent - Staging Environment Configuration Template (.env.staging)
# ==============================================================================
APP_NAME="BI Agent Staging"
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

DOMAIN_NAME=staging-biagent.yourdomain.com
CORS_ORIGINS=https://staging-biagent.yourdomain.com,http://localhost:3000

POSTGRES_USER=biagent_staging
POSTGRES_PASSWORD=staging_db_secret_key_12345
POSTGRES_DB=biagent_staging

DATABASE_URL=postgresql+asyncpg://biagent_staging:staging_db_secret_key_12345@postgres:5432/biagent_staging
DATABASE_URL_SYNC=postgresql://biagent_staging:staging_db_secret_key_12345@postgres:5432/biagent_staging
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

REDIS_PASSWORD=staging_redis_secret_key_12345
REDIS_URL=redis://:staging_redis_secret_key_12345@redis:6379/0
CELERY_BROKER_URL=redis://:staging_redis_secret_key_12345@redis:6379/1
CELERY_RESULT_BACKEND=redis://:staging_redis_secret_key_12345@redis:6379/2
REDIS_CACHE_TTL=300

JWT_SECRET_KEY=staging-jwt-secret-key-minimum-32-chars-long!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

ENCRYPTION_KEY=dGVzdF9mZXJuZXRfa2V5X2Zvcl9zdGFnaW5nX2Vudmlyb25tZW50XzE=

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-staging-mock-or-actual-key
LLM_REQUEST_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/app/uploads

RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_BURST=50
QUERY_MAX_ROWS=10000
QUERY_TIMEOUT_SECONDS=30
QUERY_MAX_COST_ESTIMATE=1000000
