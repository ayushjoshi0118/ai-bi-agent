# ==============================================================================
# BI Agent - Production Environment Template (.env.production)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.production on your secure production deployment host.
# 2. Populate all REQUIRED values with high-entropy cryptographic strings.
# 3. DO NOT COMMIT .env.production TO VERSION CONTROL.
# ==============================================================================

# ── 1. Application & Runtime ───────────────────────────────────────────────────
APP_NAME="BI Agent Enterprise"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ── 2. Host & Domains ──────────────────────────────────────────────────────────
DOMAIN_NAME=biagent.yourdomain.com
CORS_ORIGINS=https://biagent.yourdomain.com

# ── 3. Database Credentials (PostgreSQL 16) ────────────────────────────────────
POSTGRES_USER=biagent
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD_MIN_32_CHARS
POSTGRES_DB=biagent_prod

# Connection Strings used by services (Internal Docker network)
DATABASE_URL=postgresql+asyncpg://biagent:REPLACE_WITH_STRONG_DB_PASSWORD_MIN_32_CHARS@postgres:5432/biagent_prod
DATABASE_URL_SYNC=postgresql://biagent:REPLACE_WITH_STRONG_DB_PASSWORD_MIN_32_CHARS@postgres:5432/biagent_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ── 4. Redis Queue & Cache (Redis 7) ───────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD_MIN_32_CHARS
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD_MIN_32_CHARS@redis:6379/0
CELERY_BROKER_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD_MIN_32_CHARS@redis:6379/1
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD_MIN_32_CHARS@redis:6379/2
REDIS_CACHE_TTL=300

# ── 5. Security & Cryptographic Secrets (REQUIRED) ─────────────────────────────
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_HEX_64_CHAR_KEY_DO_NOT_LEAK
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate Fernet key via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_BASE64_KEY_DO_NOT_LEAK

# ── 6. LLM AI Provider Configuration ──────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-proj-YOUR_ACTUAL_PRODUCTION_API_KEY
LLM_REQUEST_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# ── 7. File Upload & Storage ───────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/app/uploads

# ── 8. Rate Limiting & Resource Protection ────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30
QUERY_MAX_ROWS=10000
QUERY_TIMEOUT_SECONDS=30
QUERY_MAX_COST_ESTIMATE=1000000

# ── 9. Error Monitoring & Observability (Optional) ────────────────────────────
SENTRY_DSN=
